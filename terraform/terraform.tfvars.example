# Copy to terraform.tfvars for a local dev deployment. This file contains no
# credentials. Terraform state remains in the remote backend configured separately.
aws_region          = "af-south-1"
environment         = "dev"
project_name        = "aws-01-secure-infrastructure"
availability_zones  = ["af-south-1a", "af-south-1b"]
vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]
instance_type       = "t3.micro"
archive_bucket_name = "gerrard-lewu-322513863494-aws01-dev-archive"
